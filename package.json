{
  "name": "vteam",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "build:web": "expo export --platform web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Chicago jest",
    "test:timezones": "for tz in America/Chicago America/Denver Europe/Berlin Asia/Tokyo UTC; do echo \"── TZ=$tz ──\"; TZ=$tz jest __tests__/calendarDates.test.ts || exit 1; done",
    "e2e:sweep": "node e2e/sweep.mjs",
    "docs:update": "node scripts/generate-architecture-doc.mjs",
    "docs:check": "node scripts/generate-architecture-doc.mjs --check",
    "db:drift": "node scripts/schema-drift.mjs",
    "test:coverage": "TZ=America/Chicago jest --coverage",
    "shots:capture": "node scripts/shots/capture.mjs",
    "shots:compare": "node scripts/shots/compare.mjs",
    "a11y": "node scripts/shots/a11y.mjs",
    "a11y:baseline": "node scripts/shots/a11y.mjs --update-baseline",
    "og:render": "tsx scripts/render-og.tsx"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "{app,components,contexts,hooks,lib,utils,constants}/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "coverageReporters": [
      "json-summary",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 35,
        "branches": 28,
        "functions": 30,
        "lines": 36
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/og": "0.11.1",
    "expo": "54",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.8",
    "expo-calendar": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "^55.0.14",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^55.0.18",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-pager-view": "^6.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-virtuoso": "^4.18.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/react-native": "^11.5.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@vercel/node": "^5.7.4",
    "axe-core": "4.14.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
