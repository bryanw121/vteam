{
  "name": "vteam",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "build:web": "expo export --platform web",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:timezones": "node scripts/test-timezones.mjs",
    "test:tz": "for tz in UTC Asia/Tokyo America/Los_Angeles; do echo \"\u2500\u2500 TZ=$tz \u2500\u2500\"; TZ=$tz jest --silent || exit 1; done",
    "e2e:sweep": "node e2e/sweep.mjs",
    "docs:update": "node scripts/generate-architecture-doc.mjs",
    "docs:check": "node scripts/generate-architecture-doc.mjs --check",
    "db:drift": "node scripts/schema-drift.mjs",
    "test:coverage": "TZ=America/Chicago jest --coverage",
    "shots:capture": "node scripts/shots/capture.mjs",
    "shots:compare": "node scripts/shots/compare.mjs",
    "a11y": "node scripts/shots/a11y.mjs",
    "a11y:baseline": "node scripts/shots/a11y.mjs --update-baseline",
    "stability": "node scripts/shots/stability-flow.mjs --dist dist-mock",
    "stability:baseline": "node scripts/shots/stability-flow.mjs --dist dist-mock --update-baseline",
    "startup": "node scripts/shots/startup-budget.mjs --dist dist-mock",
    "startup:baseline": "node scripts/shots/startup-budget.mjs --dist dist-mock --update",
    "og:render": "tsx scripts/render-og.tsx"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/.*|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "globalSetup": "./jest.globalSetup.js",
    "collectCoverageFrom": [
      "{app,components,contexts,hooks,lib,utils,constants}/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "coverageReporters": [
      "json-summary",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 35,
        "branches": 28,
        "functions": 30,
        "lines": 36
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/og": "0.11.1",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-auth-session": "~58.0.18",
    "expo-blur": "~58.0.6",
    "expo-calendar": "~58.0.7",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-virtuoso": "^4.18.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^11.5.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@vercel/node": "^5.7.4",
    "axe-core": "4.14.0",
    "jest": "^29.2.1",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "^19.3.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
